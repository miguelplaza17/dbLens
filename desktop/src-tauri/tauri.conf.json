{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dbLens",
  "version": "1.5.0",
  "identifier": "app.dblens.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dbLens",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGM0IwM0I3RkNBQkQ3OEYKUldTUDE2djh0d003VHd5c2w4UkhXUTI1UEkwWDArY1ZoeTNxVXRqM0svSy8vanV2TGUzb1dCL2QK",
      "endpoints": ["https://github.com/miguelplaza17/dbLens/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm", "msi", "nsis", "app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "A fast, minimal database client",
    "longDescription": "Paste a connection string, click a table, see and edit the rows, run SQL. PostgreSQL, MySQL/MariaDB, SQLite, Redis/Valkey and MongoDB.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "entitlements": null,
      "dmg": {
        "windowSize": { "width": 540, "height": 380 },
        "appPosition": { "x": 140, "y": 190 },
        "applicationFolderPosition": { "x": 400, "y": 190 }
      }
    }
  }
}
